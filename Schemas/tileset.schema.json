{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yume-arisu.dev/schema/tileset.schema.json",
  "title": "YumeArisu Tileset",
  "description": "YumeArisu에서 사용하는 타일셋 메타데이터 파일입니다.",
  "type": "object",
  "properties": {
    "TexturePath": {
      "type": "string",
      "description": "이 타일셋에서 사용할 Texture 리소스의 경로입니다."
    },
    "TileWidth": {
      "type": "integer",
      "minimum": 1,
      "description": "타일 하나의 픽셀 너비입니다."
    },
    "TileHeight": {
      "type": "integer",
      "minimum": 1,
      "description": "타일 하나의 픽셀 높이입니다."
    }
  },
  "required": [
    "TexturePath",
    "TileWidth",
    "TileHeight"
  ],
  "additionalProperties": false
}