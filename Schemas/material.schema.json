{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yume-arisu.dev/schema/material.schema.json",
  "title": "YumeArisu Material",
  "description": "YumeArisu에서 사용하는 머티리얼 메타데이터 파일입니다.",
  "type": "object",
  "properties": {
    "ShaderPath": {
      "type": "string",
      "description": "이 머티리얼에서 사용할 Shader 리소스의 경로입니다."
    },
    "BlendMode": {
      "type": "string",
      "enum": [
        "Opaque",
        "Alpha",
        "Additive"
      ],
      "description": "머티리얼의 색상 블렌딩 모드입니다."
    },
    "RenderQueue": {
      "type": "string",
      "enum": [
        "Geometry",
        "Transparent",
        "UI"
      ],
      "description": "머티리얼의 렌더링 단계입니다. 앞 단계부터 먼저 렌더링됩니다."
    },
    "TexturePaths": {
      "type": "object",
      "description": "Sampler ShaderProperty에서 참조하는 Texture 리소스의 경로입니다.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ShaderProperties": {
      "type": "object",
      "description": "이 머티리얼에 설정할 ShaderProperty 값입니다.",
      "additionalProperties": {
        "$ref": "#/$defs/ShaderPropertyValue"
      }
    }
  },
  "required": [
    "ShaderPath",
    "TexturePaths",
    "ShaderProperties"
  ],
  "additionalProperties": false,
  "$defs": {
    "ShaderPropertyValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/Float"
        },
        {
          "$ref": "#/$defs/Vec2"
        },
        {
          "$ref": "#/$defs/Vec3"
        },
        {
          "$ref": "#/$defs/Vec4"
        },
        {
          "$ref": "#/$defs/Mat4"
        },
        {
          "$ref": "#/$defs/Int"
        }
      ]
    },
    "Float": {
      "type": "object",
      "properties": {
        "Type": {
          "const": "Float"
        },
        "Value": {
          "$ref": "#/$defs/Vector4"
        }
      },
      "required": [
        "Type",
         "Value"
      ],
      "additionalProperties": false
    },
    "Vec2": {
      "type": "object",
      "properties": {
        "Type": {
          "const": "Vec2"
        },
        "Value": {
          "$ref": "#/$defs/Vector4"
        }
      },
      "required": [
        "Type",
         "Value"
      ],
      "additionalProperties": false
    },
    "Vec3": {
      "type": "object",
      "properties": {
        "Type": {
          "const": "Vec3"
        },
        "Value": {
          "$ref": "#/$defs/Vector4"
        }
      },
      "required": [
        "Type",
         "Value"
      ],
      "additionalProperties": false
    },
    "Vec4": {
      "type": "object",
      "properties": {
        "Type": {
          "const": "Vec4"
        },
        "Value": {
          "$ref": "#/$defs/Vector4"
        }
      },
      "required": [
        "Type",
         "Value"
      ],
      "additionalProperties": false
    },
    "Mat4": {
      "type": "object",
      "properties": {
        "Type": {
          "const": "Mat4"
        },
        "Matrix": {
          "$ref": "#/$defs/Matrix4x4"
        }
      },
      "required": [
        "Type",
        "Matrix"
      ],
      "additionalProperties": false
    },
    "Int": {
      "type": "object",
      "properties": {
        "Type": {
          "const": "Int"
        },
        "Value": {
          "$ref": "#/$defs/Vector4"
        }
      },
      "required": [
        "Type",
         "Value"
      ],
      "additionalProperties": false
    },
    "Vector4": {
      "type": "object",
      "properties": {
        "X": { "type": "number" },
        "Y": { "type": "number" },
        "Z": { "type": "number" },
        "W": { "type": "number" }
      },
      "required": ["X", "Y", "Z", "W"],
      "additionalProperties": false
    },
    "Matrix4x4": {
      "type": "object",
      "properties": {
        "M11": { "type": "number" }, "M12": { "type": "number" },
        "M13": { "type": "number" }, "M14": { "type": "number" },
        "M21": { "type": "number" }, "M22": { "type": "number" },
        "M23": { "type": "number" }, "M24": { "type": "number" },
        "M31": { "type": "number" }, "M32": { "type": "number" },
        "M33": { "type": "number" }, "M34": { "type": "number" },
        "M41": { "type": "number" }, "M42": { "type": "number" },
        "M43": { "type": "number" }, "M44": { "type": "number" }
      },
      "required": [
        "M11", "M12", "M13", "M14", "M21", "M22", "M23", "M24",
        "M31", "M32", "M33", "M34", "M41", "M42", "M43", "M44"
      ],
      "additionalProperties": false
    }
  }
}